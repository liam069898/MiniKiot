{
    "name": "minikiot-webapp",
    "version": "1.6.0",
    "description": "NKiot - POS với Node.js, SQLite và giao diện JavaScript",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "bench": "node scripts/bench.js",
        "test": "node --test tests/*.test.js",
        "check": "node scripts/check.js",
        "backup": "node backup.js",
        "assets:build": "tailwindcss -i ./tailwind.input.css -o ./public/tailwind.css --minify",
        "format:check": "prettier --check *.js tests/*.js scripts/*.js .prettierrc.json package.json"
    },
    "keywords": [
        "kiotviet",
        "pos",
        "retail",
        "management"
    ],
    "author": "Antigravity",
    "license": "ISC",
    "devDependencies": {
        "@fontsource-variable/inter": "5.3.0",
        "acorn": "^8.19.0",
        "jsdom": "^30.1.3",
        "prettier": "^3.9.10",
        "tailwindcss": "3.4.19"
    },
    "engines": {
        "node": ">=24.0.0"
    }
}
